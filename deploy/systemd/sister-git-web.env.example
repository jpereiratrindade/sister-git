# SisTer Git Web - Configuração de Ambiente de Produção
# Localização recomendada no servidor: /etc/sister-git-web.env (chmod 600)

SISTER_GIT_ROOT=/srv/git
SISTER_GIT_ADMIN_EMAIL=administrador@embrapa.br
SISTER_GIT_WEB_ROOT=/usr/local/share/sister-git/web
SISTER_BIND=0.0.0.0
SISTER_PORT=8787

# SMTP Institucional / Gmail para envio de códigos de autenticação editorial (OTP)
SISTER_SMTP_USER=seu-email@gmail.com
SISTER_SMTP_PASS=sua-senha-de-app
SISTER_SMTP_FROM=seu-email@gmail.com
SISTER_SMTP_HOST=smtp.gmail.com
SISTER_SMTP_PORT=587
