#!/usr/bin/env bash
# SisTer Git — somente repositórios bare + Git sobre SSH.
# Não configura rede, firewall ou servidores adicionais.
set -euo pipefail

ROOT="${SISTER_GIT_ROOT:-/srv/git}"
usage() {
  cat <<'HELP'
SisTer Git — hospedagem Git minimalista
Uso: sister-git init NOME | list | info NOME | check NOME | head NOME BRANCH | backup NOME DIRETORIO | help
  init NOME   Cria /srv/git/NOME.git (bare, branch inicial master)
  list        Exibe repositórios existentes
  info NOME   Exibe informações do repositório
  check NOME  Executa git fsck --full
  head NOME BRANCH  Define a branch HEAD do bare (a branch deve existir)
  backup NOME DIRETORIO  Cria bundle Git completo no destino existente
Variável de teste: SISTER_GIT_ROOT (altera só o diretório-base)
HELP
}
fail(){ printf '[ERRO] %s\n' "$*" >&2; exit 1; }
valid_name(){
  # Sem caminhos, nomes começando com ponto, barras ou caracteres de shell.
  [[ "$1" =~ ^[[:alpha:]][[:alnum:]_.-]{0,63}$ ]] \
    && [[ "$1" != *..* ]] && [[ "$1" != *.git ]]
}
check_root(){
  [[ -d "$ROOT" && ! -L "$ROOT" ]] || fail "Diretório raiz ausente ou simbólico: $ROOT"
}
repo_path(){
  local name="$1"
  valid_name "$name" || fail "Nome inválido: $name. Use letras/números/_/.-, sem caminhos e sem .git"
  printf '%s/%s.git' "$ROOT" "$name"
}
is_bare(){
  [[ -d "$1" && ! -L "$1" ]] &&
    [[ "$(git --git-dir="$1" rev-parse --is-bare-repository 2>/dev/null || true)" == true ]]
}
[[ $# -ge 1 ]] || { usage; exit 2; }
command="$1"; shift
case "$command" in
  help|-h|--help) usage ;;
  init)
    [[ $# -eq 1 ]] || fail 'Uso: sister-git init NOME'
    check_root
    path="$(repo_path "$1")"
    if [[ -e "$path" || -L "$path" ]]; then
      is_bare "$path" || fail "Caminho ocupado por item que não é bare: $path"
      printf '[OK] Repositório existente preservado: %s\n' "$path"
      exit 0
    fi
    git init --bare --initial-branch=master "$path"
    git --git-dir="$path" config receive.denyNonFastForwards true
    git --git-dir="$path" config receive.denyDeletes true
    git --git-dir="$path" config core.logAllRefUpdates true
    git --git-dir="$path" config receive.fsckObjects true
    chmod 0700 "$path"
    printf '[OK] Repositório bare criado: %s\n' "$path"
    ;;
  list)
    [[ $# -eq 0 ]] || fail 'Uso: sister-git list'
    check_root
    shopt -s nullglob
    count=0
    for path in "$ROOT"/*.git; do
      if is_bare "$path"; then
        printf '%s\n' "$(basename "$path")"
        ((count+=1))
      fi
    done
    ((count>0)) || echo '(nenhum repositório)'
    ;;
  info)
    [[ $# -eq 1 ]] || fail 'Uso: sister-git info NOME'
    check_root
    path="$(repo_path "$1")"
    is_bare "$path" || fail "Repositório bare inexistente: $path"
    echo "Caminho: $path"
    echo "HEAD: $(git --git-dir="$path" symbolic-ref HEAD || true)"
    echo "Branches:"
    git --git-dir="$path" for-each-ref --format='  %(refname:short) %(objectname:short)' refs/heads
    echo "Espaço: $(du -sh "$path" | awk '{print $1}')"
    echo "Proteção de histórico: $(git --git-dir="$path" config --get receive.denyNonFastForwards)"
    ;;
  head)
    [[ $# -eq 2 ]] || fail 'Uso: sister-git head NOME BRANCH'
    check_root
    path="$(repo_path "$1")"
    is_bare "$path" || fail "Repositório bare inexistente: $path"
    branch="$2"
    git check-ref-format --branch "$branch" >/dev/null 2>&1 || fail "Branch inválida: $branch"
    git --git-dir="$path" show-ref --verify --quiet "refs/heads/$branch" || fail "Branch não existe: $branch"
    git --git-dir="$path" symbolic-ref HEAD "refs/heads/$branch"
    printf '[OK] HEAD aponta para refs/heads/%s\n' "$branch"
    ;;
  backup)
    [[ $# -eq 2 ]] || fail 'Uso: sister-git backup NOME DIRETORIO'
    check_root
    path="$(repo_path "$1")"
    is_bare "$path" || fail "Repositório bare inexistente: $path"
    command -v sister-git-redundancy >/dev/null 2>&1 || fail 'sister-git-redundancy não instalado'
    exec sister-git-redundancy bundle "$path" "$2"
    ;;
  check)
    [[ $# -eq 1 ]] || fail 'Uso: sister-git check NOME'
    check_root
    path="$(repo_path "$1")"
    is_bare "$path" || fail "Repositório bare inexistente: $path"
    git --git-dir="$path" fsck --full
    echo '[OK] Integridade Git verificada'
    ;;
  *) fail "Comando desconhecido: $command" ;;
esac
